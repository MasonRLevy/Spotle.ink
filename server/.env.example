# Gemini AI Referee (Role 4) — get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Optional. Single model, or a comma-separated fallback chain tried in order.
# Default chain: gemini-3.1-flash-lite,gemini-3.8-flash,gemini-3.5-flash-lite
# NOTE: the free tier allows only ~20 requests/day PER MODEL, which a single
# 4-player match can exhaust. Each model has its own quota bucket, so the chain
# buys headroom — but enable billing before the live demo.
# NOTE: gemini-2.5-flash is no longer callable on newly created keys.
# GEMINI_MODEL=gemini-3.1-flash-lite

# Optional. Port for the standalone referee workbench (default 4005).
# REFEREE_TEST_PORT=4005
